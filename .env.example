# Run: python scripts/configure.py (generates .env with random local secrets).
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://hookdesk:hookdesk@localhost:5432/hookdesk
POSTGRES_USER=hookdesk
POSTGRES_PASSWORD=replace-with-generated-password
POSTGRES_DB=hookdesk
REDIS_URL=redis://localhost:6379/0
ENCRYPTION_KEY=generate-a-fernet-key-with-scripts-configure.py
PUBLIC_BASE_URL=http://localhost:8000
COOKIE_SECURE=false
DEMO_ENABLED=false
MAX_ATTEMPTS=5
RETRY_BASE_SECONDS=5
RETRY_MAX_SECONDS=300
LEASE_SECONDS=60
DISCOVERY_SECONDS=5
